# Core
USE_OPENAI=false
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Concurrency
MAX_CONCURRENCY=4

# Zero-shot models
ZERO_SHOT_MULTILINGUAL=true
ZERO_SHOT_MODEL_EN=facebook/bart-large-mnli
ZERO_SHOT_MODEL_MULTI=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# Paths
KEYWORDS_PATH=./data/crime_keywords.json
LOGS_PATH=./logs/analysis_log.jsonl
CACHE_DIR=./.cache

# Optional
ENABLE_TRANSLATION=false
